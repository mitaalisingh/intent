{
  "manifest_version": 3,
  "name": "Intent",
  "version": "0.3.0",
  "description": "A calmer YouTube that helps you do what you came to do.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Intent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["levels.js", "selectors.js", "prompt.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
